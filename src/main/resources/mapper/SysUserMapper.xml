<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.m7m.omnitranslate.mapper.SysUserMapper">


    <select id="selectByUsername" resultType="SysUser">
        select id,username,password,user_id,phone,email,avatar,status,last_login_time,create_time,update_time,deleted
        from sys_user where username = #{username}
    </select>

    <insert id="insert" parameterType="SysUser" keyProperty="id">
        INSERT INTO  sys_user(id,username,password,user_id,phone,email,status,create_time,deleted)
        VALUES (#{id},#{username},#{password},#{userId},#{phone},#{email},#{status},NOW(),#{deleted})
    </insert>


    <select id="findByUserId" resultType="SysUser">
        select id,username,password,user_id,phone,email,avatar,status,last_login_time,create_time,update_time,deleted
        from sys_user where user_id = #{userId}
    </select>

</mapper>
